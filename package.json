{
  "name": "exec-staged",
  "version": "0.3.0",
  "description": "Run commands against the current git index",
  "keywords": [
    "git",
    "lint",
    "staged",
    "lint-staged",
    "pre-commit",
    "commit",
    "hook"
  ],
  "repository": "github:ItsNickBarry/exec-staged",
  "license": "MIT",
  "author": "Nick Barry",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "exec-staged": "./dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "pnpm clean && tsc --build",
    "clean": "rm -rf dist/",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "test": "pnpm build && tsx --test --experimental-test-coverage"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "env-paths": "^4.0.0",
    "execa": "^10.2.0",
    "micromatch": "^4.0.8",
    "semver": "^7.8.5",
    "signal-exit": "^4.1.0",
    "string-argv": "^0.4.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "github:ItsNickBarry/lint-staged#knip",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "release-it": "^21.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
